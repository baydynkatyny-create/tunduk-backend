# Бул файлды копиялап, ".env" деп атаңыз, андан кийин чыныгы ачкычтарды коюңуз.
# .env файлын ЭЧ КАЧАН GitHub'го же жалпыга ачык жерге жайгаштырбаңыз!

ANTHROPIC_API_KEY=sk-ant-...сиздин_ачкычыңыз...
GEMINI_API_KEY=AIza...сиздин_ачкычыңыз...

# Сервер кайсы портто иштесин (Railway/Render өзү орнотот, жергиликтүү үчүн 3000)
PORT=3000

# Канча колдонуучуга уруксат берилет (CORS) — тестирлөө үчүн * коюуга болот,
# продукцияда так домениңизди жазыңыз, мис: https://tunduk.kg
ALLOWED_ORIGIN=*

# Админ статистикасын көрүү үчүн жеке ачкыч (өзүңүз ойлоп табыңыз, эч кимге бербеңиз)
ADMIN_KEY=менин_купуя_админ_ачкычым_12345

